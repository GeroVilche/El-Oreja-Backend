# Copiá este archivo como .env y completá los valores.
# Este archivo SÍ se sube a GitHub: sirve de guía, por eso no tiene valores reales.

# ID del Google Calendar donde se guardan los turnos (suele ser un email)
CALENDAR_ID=

# Número de WhatsApp del negocio, con código de país y sin "+" ni espacios (ej: 549XXXXXXXXXX)
NUMERO_WHATSAPP_NEGOCIO=

# URL donde está publicado el frontend, sin "/" al final (se usa para armar el link de cancelación)
FRONTEND_URL=

# Opcional. Puerto del servidor (por defecto 3000; en Render lo asigna Render solo)
# PORT=

# Solo en producción: el contenido COMPLETO del archivo JSON de la cuenta de servicio de Google.
# En tu compu no hace falta: si no está, se usa el archivo google-credentials.json.
# GOOGLE_CREDENTIALS=
