# Copiá este archivo como .env y completá los valores.
# Este archivo SÍ se sube a GitHub: sirve de guía, por eso no tiene valores reales.

# ID del Google Calendar donde se guardan los turnos (suele ser un email)
CALENDAR_ID=

# Número de WhatsApp del negocio, con código de país y sin "+" ni espacios (ej: 549XXXXXXXXXX)
NUMERO_WHATSAPP_NEGOCIO=

# URL donde está publicado el frontend, sin "/" al final (se usa para armar el link de cancelación)
FRONTEND_URL=

# Opcional. Otros orígenes que pueden usar la API desde el navegador, separados por coma
# (el origen de FRONTEND_URL ya está permitido). Ej: http://localhost:5500
# CORS_ORIGENES_EXTRA=

# Opcional. Cuántas reservas puede hacer una misma IP por hora (por defecto 5).
# En tu compu conviene subirlo (ej. 100) para poder probar sin que te bloquee.
# LIMITE_RESERVAS_POR_HORA=

# Solo en producción (Render): el servidor está detrás de 1 proxy. Necesario para que el
# límite de pedidos por IP vea la IP real de cada visitante. En tu compu NO va.
# TRUST_PROXY=1

# Opcional. Puerto del servidor (por defecto 3000; en Render lo asigna Render solo)
# PORT=

# Solo en producción: el contenido COMPLETO del archivo JSON de la cuenta de servicio de Google.
# En tu compu no hace falta: si no está, se usa el archivo google-credentials.json.
# GOOGLE_CREDENTIALS=

# Opcional, solo para testear en tu compu. Pisa el límite para cancelar de config/negocio.js
# (cancelacion.horasLimite). Con 0 se puede cancelar cualquier turno que todavía no pasó.
# En producción NO va: se usa el valor de la config.
# HORAS_LIMITE_CANCELACION=